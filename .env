# Database
DATABASE_HOST=questly-db
DATABASE_PORT=5432
DATABASE_NAME=questly
DATABASE_USERNAME=questly
DATABASE_PASSWORD=changeme
DATABASE_SSL=false

# Strapi Secrets (Generate new ones for production!)
# You can generate them using `openssl rand -base64 32`
JWT_SECRET=changeme
ADMIN_JWT_SECRET=changeme
APP_KEYS=changeme,changeme
API_TOKEN_SALT=changeme
TRANSFER_TOKEN_SALT=changeme
ENCRYPTION_KEY=changeme

# Server
HOST=0.0.0.0
PORT=1337

# Frontend
NEXT_PUBLIC_STRAPI_URL=
STRAPI_URL=http://questly-backend:1337
# Note: NEXT_PUBLIC_STRAPI_URL should be empty so the browser makes requests to /api (relative).
# Next.js will then proxy these requests to STRAPI_URL (http://questly-backend:1337).
