{
    "kind": "collectionType",
    "collectionName": "cards",
    "info": {
        "singularName": "card",
        "pluralName": "cards",
        "displayName": "Card"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "slug": {
            "type": "uid",
            "required": true
        },
        "difficulty": {
            "type": "enumeration",
            "enum": [
                "easy",
                "medium",
                "hard"
            ]
        },
        "symbol_seed": {
            "type": "string"
        },
        "quest_text": {
            "type": "text"
        },
        "categories": {
            "type": "relation",
            "relation": "manyToMany",
            "target": "api::category.category",
            "inversedBy": "cards"
        },
        "owner": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "plugin::users-permissions.user",
            "inversedBy": "cards"
        },
        "post": {
            "type": "relation",
            "relation": "oneToOne",
            "target": "api::post.post",
            "mappedBy": "attached_card"
        }
    }
}
