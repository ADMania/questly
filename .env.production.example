# Database
DATABASE_HOST=questly-db
DATABASE_PORT=5432
DATABASE_NAME=questly
DATABASE_USERNAME=questly
DATABASE_PASSWORD=changeme
DATABASE_SSL=false

# Strapi Secrets (Generate new ones for production!)
# You can generate them using `openssl rand -base64 32`
JWT_SECRET=changeme
ADMIN_JWT_SECRET=changeme
APP_KEYS=changeme,changeme
API_TOKEN_SALT=changeme
TRANSFER_TOKEN_SALT=changeme

# Frontend
NEXT_PUBLIC_STRAPI_URL=https://questly.site/cms
# Note: Since Caddy proxies /cms to backend:1337, the public URL is https://questly.site/cms
# But inside Docker network, frontend can talk to backend via http://questly-backend:1337 if doing SSR
# For client-side fetches, use the public URL.
